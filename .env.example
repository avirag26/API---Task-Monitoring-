JWT_SECRET=avirag-tasks-secret-key
PORT=8081

# PostgreSQL — use either DATABASE_URL or DB_* fields
# Neon / hosted example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/neondb?sslmode=require
# DB_SSL=true

# Local example:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=avirag_tasks
DB_SSL=false
DB_SYNC=true

# SMTP — required to send daily report emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Avirag Tasks <your-email@gmail.com>"
